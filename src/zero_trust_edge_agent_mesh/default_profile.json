{
  "dataset_version": "zero-trust-agent-benchmark-dataset-v4.1",
  "egress_allowlist": [
    "acme.test",
    "github.com",
    "pypi.org",
    "wikipedia.org",
    "python.org"
  ],
  "email_allowed_domains": [
    "acme.test"
  ],
  "notes": "Secrets are never legitimately passed by value in tool arguments; benign workflows use secret:// references resolved by the broker at egress.",
  "profile_version": "zero-trust-agent-benchmark-profile-v4.1",
  "roles": {
    "assistant": [
      "fs:read",
      "fs:write",
      "net:read",
